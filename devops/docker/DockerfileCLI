FROM golang:1.27-alpine AS builder
LABEL author="Kevin Lactio Kemta<kevin.lactio-kemta-ext@cavom.fr>"

RUN apk add --no-cache make

WORKDIR /app

COPY ../../go.mod go.sum Makefile ./
RUN go mod download

COPY ../../.. .

RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    make build-cli-prod


FROM alpine:3.22

ARG YQ_VERSION=4.53.3
ARG TARGETOS=
ARG TARGETARCH=

RUN apk -U upgrade \
    && apk add --no-cache ca-certificates bash openssh jq git curl \
    && wget -q https://github.com/mikefarah/yq/releases/download/v${YQ_VERSION}/yq_${TARGETOS}_${TARGETARCH} -O /usr/local/bin/yq \
    && addgroup -S sbridge \
    && adduser -S -G sbridge sbridge

COPY --from=builder /app/bin/sonarbridge-cli /usr/local/bin/bridgectl
RUN chmod +x /usr/local/bin/bridgectl

USER sbridge

WORKDIR /workspace

CMD ["/usr/local/bin/bridgectl"]
