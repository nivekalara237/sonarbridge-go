FROM golang:1.26-alpine AS builder
LABEL author="Kevin Lactio Kemta<kevin.lactio-kemta-ext@cavom.fr>"

RUN apk add --no-cache make

WORKDIR /app

COPY ../../go.mod go.sum Makefile ./
RUN go mod download

COPY ../../.. .

RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    make build-server-prod


FROM alpine:3.22
RUN apk add --no-cache ca-certificates \
    && addgroup -S sbridge \
    && adduser -S -G sbridge sbridge

COPY --from=builder /app/bin/sonarbridge-server /usr/local/bin/sonarbridge-server

USER sbridge

EXPOSE 9405

ENTRYPOINT ["sonarbridge-server"]

CMD ["serve", "--port=9405"]
